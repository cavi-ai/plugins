{
  "$schema": "./catalog.schema.json",
  "name": "cavi-ai",
  "plugins": [
    {
      "name": "mlx-agent",
      "repository": "cavi-ai/mlx-agent",
      "license": "MIT",
      "summary": "Discover, verify, and wire local MLX-optimized models on Apple Silicon.",
      "hosts": ["claude", "codex", "agy", "opencode", "openclaw", "hermes", "agentskills"],
      "packages": {
        "claude": { "path": "." },
        "codex": { "path": "packages/codex/mlx-agent" },
        "agy": { "path": "providers/agy" },
        "opencode": { "path": "providers/opencode" },
        "openclaw": { "path": "providers/agentskills" },
        "hermes": { "path": "providers/agentskills" },
        "agentskills": { "path": "providers/agentskills" }
      }
    },
    {
      "name": "obsidian-agent",
      "repository": "cavi-ai/obsidian-agent",
      "license": "MIT",
      "summary": "Run portable, safety-gated Obsidian vault workflows through the official Obsidian CLI.",
      "hosts": ["claude", "codex", "opencode", "agentskills"],
      "packages": {
        "claude": { "path": "." },
        "codex": { "path": "packages/codex/obsidian-agent" },
        "opencode": { "path": "providers/opencode" },
        "agentskills": { "path": "providers/agentskills" }
      }
    },
    {
      "name": "loop-killer",
      "repository": "cavi-ai/loop-killer",
      "license": "MIT",
      "summary": "End stop-hook re-prompt loops by clearing the active goal.",
      "hosts": ["claude"],
      "packages": {
        "claude": { "path": "." }
      }
    }
  ]
}
